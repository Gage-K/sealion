# The WebSocket relay. Tiny Node process, listens on $PORT (default 8080).
# Context is the repo root (like bibliotab) so the pnpm workspace + lockfile are available.
FROM node:22-alpine
RUN corepack enable
WORKDIR /app

# Only the server's deps (ws).
COPY pnpm-workspace.yaml pnpm-lock.yaml package.json ./
COPY server/package.json ./server/
COPY client/package.json ./client/
RUN pnpm install --frozen-lockfile --filter @sealion/server --prod

COPY server/ ./server/

ENV PORT=8080
EXPOSE 8080
# Run from the repo root so `ws` resolves from the hoisted node_modules.
CMD ["node", "server/app.js"]
